 {
  "n": 1,
  "title": "",
  "question": "For each infection case, the number of involved patients, contributing doctors and tests performed. Each table is counted separately first, joining all three at once would multiply the rows (patients x doctors x tests).",
  "technique": "CTEs, LEFT JOIN, COALESCE",
  "sql": "WITH p AS (SELECT case_id, COUNT(*) AS n FROM case_patient GROUP BY case_id),\n     d AS (SELECT case_id, COUNT(DISTINCT doctor_id) AS n FROM works_on GROUP BY case_id),\n     t AS (SELECT case_id, COUNT(*) AS n FROM tests GROUP BY case_id)\nSELECT ic.case_id,\n       COALESCE(p.n, 0) AS num_patients,\n       COALESCE(d.n, 0) AS num_doctors,\n       COALESCE(t.n, 0) AS num_tests\nFROM infection_case ic\nLEFT JOIN p ON p.case_id = ic.case_id\nLEFT JOIN d ON d.case_id = ic.case_id\nLEFT JOIN t ON t.case_id = ic.case_id\nORDER BY ic.case_id;",
  "columns": [
   "case_id",
   "num_patients",
   "num_doctors",
   "num_tests"
  ],
