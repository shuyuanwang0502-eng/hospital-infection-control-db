 {
  "n": 11,
  "title": "Response time",
  "question": "How fast does testing start after an outbreak is detected? Hours from detection to the first test, compared within each ward.",
  "technique": "interval arithmetic, AVG() OVER, RANK() OVER",
  "sql": "WITH first_test AS (\n    SELECT case_id, MIN(\"timestamp\") AS first_test_at\n    FROM tests GROUP BY case_id\n)\nSELECT ic.case_id, ic.ward, ic.infection_type,\n       ROUND(EXTRACT(EPOCH FROM ft.first_test_at - ic.detection_time) / 3600, 1) AS hours_to_first_test,\n       ROUND(AVG(EXTRACT(EPOCH FROM ft.first_test_at - ic.detection_time) / 3600)\n             OVER (PARTITION BY ic.ward), 1)                                    AS ward_avg_hours,\n       RANK() OVER (PARTITION BY ic.ward ORDER BY ft.first_test_at - ic.detection_time) AS rank_in_ward\nFROM infection_case ic\nJOIN first_test ft ON ft.case_id = ic.case_id\nORDER BY ic.ward, rank_in_ward;",
  "columns": [
   "case_id",
   "ward",
   "infection_type",
   "hours_to_first_test",
   "ward_avg_hours",
   "rank_in_ward"
  ],
