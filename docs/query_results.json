 {
  "n": 12,
  "title": "Cases that share patients",
  "question": "Pairs of cases with 4 or more patients in common. A shared patient could be a link between two outbreaks.",
  "technique": "self join, STRING_AGG",
  "sql": "SELECT a.case_id AS case_a, b.case_id AS case_b,\n       COUNT(*)  AS shared_patients,\n       STRING_AGG(a.patient_id::text, ', ' ORDER BY a.patient_id) AS patient_ids\nFROM case_patient a\nJOIN case_patient b ON b.patient_id = a.patient_id AND b.case_id > a.case_id\nGROUP BY a.case_id, b.case_id\nHAVING COUNT(*) >= 4\nORDER BY shared_patients DESC, case_a, case_b;",
  "columns": [
   "case_a",
   "case_b",
   "shared_patients",
   "patient_ids"
