          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-266" value="&amp;nbsp;Each sample is collected for exactly one infection case, making participation total for samples." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-263" vertex="1">
