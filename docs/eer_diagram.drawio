          <mxGeometry x="256" width="314" height="84" as="geometry">
            <mxRectangle width="314" height="84" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-251" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-246" vertex="1">
          <mxGeometry y="84" width="569.51" height="97" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-252" value="&amp;nbsp;belongs_to (INFECTION CASE – PATIENTS)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-251" vertex="1">
          <mxGeometry width="125" height="97" as="geometry">
            <mxRectangle width="125" height="97" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-253" value="&lt;div&gt;M:N, total participation on both sides&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-251" vertex="1">
          <mxGeometry x="125" width="131" height="97" as="geometry">
            <mxRectangle width="131" height="97" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-254" value="A patient can be involved in multiple infection cases, and a case involves multiple patients. Total participation for patients ensures every case has at least one patient.&amp;nbsp;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-251" vertex="1">
          <mxGeometry x="256" width="314" height="97" as="geometry">
            <mxRectangle width="314" height="97" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-255" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-246" vertex="1">
          <mxGeometry y="181" width="569.51" height="147" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-256" value="supervised_by (INFECTION CASE – DOCTORS)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-255" vertex="1">
          <mxGeometry width="125" height="147" as="geometry">
            <mxRectangle width="125" height="147" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-257" value="N:1, total participation on the case side" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-255" vertex="1">
          <mxGeometry x="125" width="131" height="147" as="geometry">
            <mxRectangle width="131" height="147" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-258" value="The supervised_by relationship between INFECTION CASE and DOCTORS has a N:1 cardinality ratio, because each infection case is supervised by exactly one lead doctor, while a single doctor can supervise multiple infection cases over time. The participation of INFECTION CASE in this relationship is total, as every case must have a supervising doctor, whereas participation of DOCTORS is partial, since not all doctors necessarily supervise cases." style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-255" vertex="1">
          <mxGeometry x="256" width="314" height="147" as="geometry">
            <mxRectangle width="314" height="147" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-259" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-246" vertex="1">
          <mxGeometry y="328" width="569.51" height="84" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-260" value="works_on (DOCTORS – INFECTION CASE)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-259" vertex="1">
          <mxGeometry width="125" height="84" as="geometry">
            <mxRectangle width="125" height="84" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-261" value="M:N, with attributes ⁠ start_date ⁠, ⁠ end_date, partial participation on both sides" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-259" vertex="1">
          <mxGeometry x="125" width="131" height="84" as="geometry">
            <mxRectangle width="131" height="84" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-262" value="This relationship captures additional doctors working on a case (beyond the lead). The partial participation on both sides reflects that not all doctors work on cases continuously.&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-259" vertex="1">
          <mxGeometry x="256" width="314" height="84" as="geometry">
            <mxRectangle width="314" height="84" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-263" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-246" vertex="1">
          <mxGeometry y="412" width="569.51" height="84" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-264" value="belongs_to (EVIDENCE SAMPLES – INFECTION CASE)" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-263" vertex="1">
          <mxGeometry width="125" height="84" as="geometry">
            <mxRectangle width="125" height="84" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-265" value="N:1, total participation on sample side" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-263" vertex="1">
          <mxGeometry x="125" width="131" height="84" as="geometry">
