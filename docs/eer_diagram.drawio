        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-183" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-182" vertex="1">
          <mxGeometry width="780" height="56" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-184" value="ENTITY" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-183" vertex="1">
          <mxGeometry width="144" height="56" as="geometry">
            <mxRectangle width="144" height="56" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-185" value="JUSTIFICATION" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-183" vertex="1">
          <mxGeometry x="144" width="636" height="56" as="geometry">
            <mxRectangle width="636" height="56" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-186" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-182" vertex="1">
          <mxGeometry y="56" width="780" height="94" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-187" value="INFECTION CASE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-186" vertex="1">
          <mxGeometry width="144" height="94" as="geometry">
            <mxRectangle width="144" height="94" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-188" value="It is a strong entity with a unique key ⁠ &lt;i&gt;&lt;b&gt;case_id&lt;/b&gt;&lt;/i&gt; ⁠. Each case represents an infection outbreak. It includes attributes such as ⁠ infection_type ⁠, ⁠ detection_date ⁠, ⁠ ward ⁠, and ⁠ status ⁠. The existence of this entity is independent (not weak) since ⁠ case_id ⁠ uniquely identifies each record." style="shape=partialRectangle;html=1;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;whiteSpace=wrap;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-186" vertex="1">
          <mxGeometry x="144" width="636" height="94" as="geometry">
            <mxRectangle width="636" height="94" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-189" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-182" vertex="1">
          <mxGeometry y="150" width="780" height="166" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-190" value="PEOPLE" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-189" vertex="1">
          <mxGeometry width="144" height="166" as="geometry">
            <mxRectangle width="144" height="166" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-191" value="It is a strong entity representing all individuals in the hospital, either patients or doctors. The unique key is ⁠ ID ⁠, as every person has a unique identifier. The attributes ⁠ Name ⁠ and ⁠ Address ⁠ are composite attributes (split into first/last name and street/city/zip), which is easier for query identification.&amp;nbsp;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;The PEOPLE entity was specialized into PATIENTS and DOCTORS because both share common attributes but differ in their specific characteristics and roles within the hospital. This total and disjoint specialization ensures that every person in the database is either a patient or a doctor.&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-189" vertex="1">
          <mxGeometry x="144" width="636" height="166" as="geometry">
            <mxRectangle width="636" height="166" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-192" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-182" vertex="1">
          <mxGeometry y="316" width="780" height="78" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-193" value="TEST" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-192" vertex="1">
          <mxGeometry width="144" height="78" as="geometry">
            <mxRectangle width="144" height="78" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-194" value="It is a weak entity because each test depends on a specific infection case(case_id) for its identification and existence. A test cannot exist independently and is uniquely identified only within the context of its case.&amp;nbsp;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-192" vertex="1">
          <mxGeometry x="144" width="636" height="78" as="geometry">
            <mxRectangle width="636" height="78" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-195" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="dkZLAvCIj3h2Z1JrKAqr-182" vertex="1">
          <mxGeometry y="394" width="780" height="66" as="geometry" />
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-196" value="EVIDENCE SAMPLES" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;" parent="dkZLAvCIj3h2Z1JrKAqr-195" vertex="1">
          <mxGeometry width="144" height="66" as="geometry">
            <mxRectangle width="144" height="66" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-197" value="It is a weak entity since each sample’s ⁠ Storage_ID ⁠ is unique only within the entity. Therefore, it has a partial key (⁠ Storage_ID ⁠) and relies on the key case_id from ⁠ INFECTION CASE ⁠ for full identification.&amp;nbsp;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontSize=12;align=left;" parent="dkZLAvCIj3h2Z1JrKAqr-195" vertex="1">
          <mxGeometry x="144" width="636" height="66" as="geometry">
            <mxRectangle width="636" height="66" as="alternateBounds" />
          </mxGeometry>
        </mxCell>
        <mxCell id="dkZLAvCIj3h2Z1JrKAqr-246" value="" style="shape=table;startSize=0;container=1;collapsible=0;childLayout=tableLayout;align=left;" parent="1" vertex="1">
          <mxGeometry x="200" y="760" width="569.51" height="900" as="geometry" />
